<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HotelLuxo.Views.SobrePage"
    Title="Sobre">

    <ScrollView>

        <VerticalStackLayout
            Padding="25"
            Spacing="20">

            <Image
                Source="developer.png"
                HeightRequest="150"
                WidthRequest="150"
                HorizontalOptions="Center"/>

            <Label
                Text="Hotel Luxo"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#0F4C81"
                HorizontalOptions="Center"/>

            <Frame
                CornerRadius="15"
                BackgroundColor="#000080">

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="Desenvolvedor"
                        FontAttributes="Bold"
                        FontSize="18"/>

                    <Label
                        Text="Lucas Moraes"/>

                    <Label
                        Text="Curso Técnico em Desenvolvimento de Sistemas"/>

                </VerticalStackLayout>

            </Frame>

            <Frame
                CornerRadius="15"
                BackgroundColor="#000080">

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="Informações do Projeto"
                        FontAttributes="Bold"
                        FontSize="18"/>

                    <Label
                        Text="Versão 1.0"/>

                    <Label
                        Text="Tecnologia: .NET MAUI"/>

                    <Label
                        Text="Ano de Desenvolvimento: 2026"/>

                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>